# ---- Server ----
NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5174
SERVER_URL=http://localhost:5050

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/solar-coop-complaints

# ---- Auth ----
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Service photos ----
# Leave the Cloudinary values empty to store photos on the server's disk (UPLOAD_DIR).
# Fill all three to store them in Cloudinary (authenticated delivery, never public).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads

# ---- Notifications / WhatsApp (n8n) ----
# Every complaint event is POSTed here as JSON when set (see README "WhatsApp / n8n").
N8N_WEBHOOK_URL=
# Shared secret n8n must send back in the x-webhook-secret header when it reports
# the customer's "Issue Resolved" / "Issue Still Exists" reply.
WEBHOOK_SECRET=

# ---- Seed: first accounts created by `npm run seed` (change the passwords after first login) ----
SEED_ADMIN_EMAIL=admin@solarcoop.dev
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
